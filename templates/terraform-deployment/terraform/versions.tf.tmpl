terraform {
  required_version = ">= 1.9.0, < 2.0.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }

  # Per-environment settings come from tfvars/<env>.tfbackend:
  #   terraform init -backend-config=tfvars/dev.tfbackend
  backend "azurerm" {
    use_azuread_auth = true
  }
}

# Subscription comes from ARM_SUBSCRIPTION_ID (set by the pipelines, or export it locally).
provider "azurerm" {
  features {}
  storage_use_azuread = true
}
